# ============================================================================
# SOLANA ARBITRAGE BOT — PRODUCTION .env TEMPLATE
# Updated: 2026-11-05
#
# تحذير أمني: هذا الملف يحتوي على أماكن شاغرة (REPLACE_ME) فقط.
# لا تضع أي مفتاح حقيقي هنا ثم ترفعه إلى git. هذا الملف مؤشر في .gitignore.
# قبل أي تشغيل مباشر، يجب تدوير كل المفاتيح التي ظهرت بنص عادي في المحادثات السابقة.
# ============================================================================

# --- General ---
ENV=production
DRY_RUN=false
LIVE=false
EXECUTE_LIVE=false
ARB_LIVE=0
ARB_MODE=shadow
LOG_LEVEL=info

# --- Live Execution Gate ---
MAX_TRADE_SIZE_USD=REPLACE_ME_MAX_TRADE_SIZE_USD
SCAN_TRIANGULAR_ROUTES=true

# --- Wallet & Operator Credentials (أضف مفاتيحك الجديدة فقط بعد التدوير) ---
SOLANA_PRIVATE_KEY=REPLACE_ME_SOLANA_PRIVATE_KEY_BASE58
OPERATOR_PUBLIC_KEY=REPLACE_ME_OPERATOR_PUBLIC_KEY
PROFIT_RECEIVER_ADDRESS=REPLACE_ME_PROFIT_RECEIVER_ADDRESS
PUMP_PORTAL_WALLET_PUBLIC_KEY=REPLACE_ME_PUMP_PORTAL_WALLET_PUBLIC_KEY

# --- Persistence ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD
DATABASE_URL=sqlite:///./data/warm/sentinel_state.db
SQLITE_WAL_PATH=./data/warm/sentinel_state.db
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD

# --- Sentinel Admin & JWT ---
# The admin HTTP API (/pause, /resume) is DISABLED unless SENTINEL_ADMIN_KEY is
# set to a non-placeholder value. Send it as "Authorization: Bearer <key>" or
# "X-Admin-Token: <key>". The API also stays bound to the loopback address.
# (config.toml `token_env` names this variable; it is resolved at runtime.)
SENTINEL_ADMIN_KEY=REPLACE_ME_SENTINEL_ADMIN_KEY
SENTINEL_ADMIN_KEYS=REPLACE_ME_SENTINEL_ADMIN_KEYS
SENTINEL_READONLY_KEYS=REPLACE_ME_SENTINEL_READONLY_KEYS
SENTINEL_WS_SECRET=REPLACE_ME_SENTINEL_WS_SECRET
X_SENTINEL_KEY=REPLACE_ME_X_SENTINEL_KEY
# Durable kill-switch marker. If this file exists at startup the bot starts
# PAUSED (fail safe). /pause creates it, /resume removes it. Default: data/kill_switch
KILL_SWITCH_FILE=./data/kill_switch
# Overrides for the kill-switch marker path / emergency disable (ops only).
# KILL_SWITCH_PATH=./data/kill_switch
# KILL_SWITCH_DISABLED=1

# --- HuggingFace Models & S3 (اختياري) ---
HF_TOKEN=REPLACE_ME_HF_TOKEN
HF_S3_ACCESS_KEY_ID=REPLACE_ME_HF_S3_ACCESS_KEY_ID
HF_S3_SECRET_ACCESS_KEY=REPLACE_ME_HF_S3_SECRET_ACCESS_KEY
HF_S3_ENDPOINT_URL=https://s3.hf.co/mohamedazooz
HF_S3_BUCKET_NAME=azoozag
HF_CODER_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
HF_SENTIMENT_MODEL=ProsusAI/finbert

# --- Solana Streaming: Yellowstone gRPC (Helius LaserStream -> solami fallback) + provider-neutral WebSockets ---
# HTTP JSON-RPC endpoints are intentionally not part of the market-data architecture.
# Provider selection (crates/arb-bot/src/supervisor.rs): when HELIUS_LASERSTREAM_ENDPOINT
# is set (https, non-placeholder) the bot ingests from Helius LaserStream using
# HELIUS_API as its x-token; SOLAMI_* below becomes a fallback, not the active ingest.
HELIUS_LASERSTREAM_ENDPOINT=https://laserstream-mainnet-fra.helius-rpc.com
HELIUS_API=REPLACE_ME_HELIUS_API_KEY
# Optional Helius stack overrides (defaults shown):
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_BETA_URL=https://beta.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_SENDER_URL=https://sender.helius-rpc.com
# HELIUS_SENDER_REGIONAL=http://fra-sender.helius-rpc.com
SOLAMI_GRPC_ENDPOINT=REPLACE_ME_SOLAMI_YELLOWSTONE_GRPC_ENDPOINT
SOLAMI_API_KEY=REPLACE_ME_SOLAMI_YELLOWSTONE_X_TOKEN
# Optional; streams all Yellowstone entries in addition to EntryUpdateParent (high bandwidth). Default false.
YELLOWSTONE_ENTRY_PARENT_UPDATES=false

# Three interchangeable Solana PubSub WebSocket slots; choose any compatible providers.
# Runtime WebSocket failover adapter is a separate acceptance item; no HTTP fallback exists.
SOLANA_WS_1_URL=REPLACE_ME_SOLANA_WS_1_URL
SOLANA_WS_2_URL=REPLACE_ME_SOLANA_WS_2_URL
SOLANA_WS_3_URL=REPLACE_ME_SOLANA_WS_3_URL

CHRONOS_DECAY_LAMBDA_PER_SEC=REPLACE_ME_CHRONOS_DECAY_LAMBDA_PER_SEC
CHRONOS_MAX_AGE_MS=REPLACE_ME_CHRONOS_MAX_AGE_MS
CHRONOS_MIN_EV_USD=REPLACE_ME_CHRONOS_MIN_EV_USD

# --- Jito Block Engine & MEV Protection ---
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
MAX_JITO_TIP_SOL=0.005
ENABLE_SOLANA_JITO=true
ZERO_LOSS_ATOMIC_REVERT_ENFORCED=true

# --- Solami gRPC & Beam ---
SOLAMI_BEAM_ENDPOINT=REPLACE_ME_SOLAMI_BEAM_ENDPOINT
SOLAMI_BEAM_PROTOCOL=QUIC
SOLAMI_BEAM_MIN_TIP_SOL=0.0001
SOLAMI_BEAM_TIP_ACCOUNTS=REPLACE_ME_SOLAMI_BEAM_TIP_ACCOUNTS

# --- Jupiter (diagnostic-only: bin/validate math differential reference) ---
JUPITER_API_KEY=REPLACE_ME_JUPITER_API_KEY
JUP_API_KEY=REPLACE_ME_JUP_API_KEY

# --- Net-profit floor (USD-denominated override; integer lamports downstream) ---
# Raises strategy.min_net_profit_abs / dlmm_three_leg.min_profit_lamports when
# both this and SOL_USD_PRICE are set. Example: 0.05 USD at SOL=200 -> 250,000 lamports.
MIN_NET_PROFIT_USD=0.05

# --- Alerts & Telemetry ---
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_ME_TELEGRAM_CHAT_ID
TELEGRAM_REJECTED_ALERT_MIN_SOL=0.005
BIRDEYE_API_KEY=REPLACE_ME_BIRDEYE_API_KEY
COINMARKETCAP_API_KEY=REPLACE_ME_COINMARKETCAP_API_KEY
COIN_MARKET_CAP_API_KEY=REPLACE_ME_COIN_MARKET_CAP_API_KEY
COINALYZE_API_KEY=REPLACE_ME_COINALYZE_API_KEY

# --- Target Pairs & Thresholds ---
ARBITRAGE_TARGET_PAIRS=SOL/USDC,USDC/USDT,BONK/SOL,WIF/SOL,ETH/USDC,BTC/USDC
MIN_NET_PROFIT_USD=0.10
DYNAMIC_MIN_PROFIT_FLOOR_USD=0.10
MAX_SLIPPAGE_BPS=30
MAX_FLASH_BORROW_USD=250000.0

# --- 1inch & EVM Support ---
ONEINCH_API_KEY=REPLACE_ME_ONEINCH_API_KEY
ONEINCH_SWAP_API_KEY=REPLACE_ME_ONEINCH_SWAP_API_KEY
ONEINCH_WS_URL=REPLACE_ME
ONEINCH_RPC_URL=REPLACE_ME
ARBITRUM_WS_URL=REPLACE_ME
EVM_WS_URL=REPLACE_ME
ETH_WS_URL=REPLACE_ME
TITAN_RPC_URL=REPLACE_ME
FLASHBOTS_RPC_URL=REPLACE_ME
BEAVER_RPC_URL=REPLACE_ME
ENABLE_ARBITRUM_FLASHLOANS=true

# --- CEX Accounts (OKX, Binance) ---
OKX_API_KEY=REPLACE_ME_OKX_API_KEY
OKX_SECRET_KEY=REPLACE_ME_OKX_SECRET_KEY
OKX_PASSPHRASE=REPLACE_ME_OKX_PASSPHRASE
BINANCE_API_KEY=REPLACE_ME_BINANCE_API_KEY
BINANCE_API_SECRET=REPLACE_ME_BINANCE_API_SECRET

# --- Network & Server Ports ---
HOST=0.0.0.0
PORT=8000
SENTINEL_WORKSPACE_ROOT=/tmp/arb-output

# --- Webhook Configuration (VPS Production Domain) ---
WEBHOOK_DOMAIN=REPLACE_ME_WEBHOOK_DOMAIN
WEBHOOK_BASE_URL=REPLACE_ME_WEBHOOK_BASE_URL
WEBHOOK_ENDPOINT_URL=REPLACE_ME_WEBHOOK_ENDPOINT_URL
WEBHOOK_HEALTH_URL=REPLACE_ME_WEBHOOK_HEALTH_URL
ALCHEMY_WEBHOOK_URL=REPLACE_ME_ALCHEMY_WEBHOOK_URL
WEBHOOK_AUTH_TOKEN=REPLACE_ME_WEBHOOK_AUTH_TOKEN
WEBHOOK_PORT=8085

# --- Solami Data & Streaming Configuration ---
SOLAMI_WEBHOOK_URL=REPLACE_ME_SOLAMI_WEBHOOK_URL
SOLAMI_MCP_URL=REPLACE_ME_SOLAMI_MCP_URL

# --- Bitquery V2 GraphQL & Streaming Configuration ---
BITQUERY_CLIENT_ID=REPLACE_ME_BITQUERY_CLIENT_ID
BITQUERY_CLIENT_SECRET=REPLACE_ME_BITQUERY_CLIENT_SECRET
BITQUERY_ACCESS_TOKEN=REPLACE_ME_BITQUERY_ACCESS_TOKEN
BITQUERY_OAUTH_URL=REPLACE_ME_BITQUERY_OAUTH_URL
BITQUERY_GRAPHQL_URL=REPLACE_ME_BITQUERY_GRAPHQL_URL


# --- Health Monitor ---
DATA_DIR=/opt/arb-bot/data
TELEGRAM_HEALTH_ALERTS=true
# Solana Transaction V1 (4096-byte, SIMD-0385) is mainnet-active, but opt-in per
# transport. Set true ONLY after every configured RPC/sender and its
# validator/leader path is verified V1-capable.
# - SOLANA_TX_V1_DIRECT_ENABLED: direct SWQoS/RPC sendTransaction path.
# - SOLANA_TX_V1_JITO_ENABLED: Jito bundle ingress (block engines carry the
#   larger v1 size; the size gate is now version-aware in validate_jito_bundle).
# Both default to false (fail-closed at the legacy 1232-byte MTU).
SOLANA_TX_V1_DIRECT_ENABLED=false
SOLANA_TX_V1_JITO_ENABLED=false

# ============================================================================
# RUNTIME / ENGINE VARIABLES (all read by bot code; defaults shown)
# ============================================================================

# --- RPC Endpoints & Pool ---
# Primary JSON-RPC endpoint(s). The pool rotates/failovers across these.
SOLANA_RPC_URL=REPLACE_ME_SOLANA_RPC_URL
SOLANA_RPC_PRIMARY=REPLACE_ME_SOLANA_RPC_PRIMARY
SOLANA_MAINNET_RPC_FALLBACK=REPLACE_ME_SOLANA_MAINNET_RPC_FALLBACK
# Low-latency endpoint preferred for the dispatch hot path (optional).
# FAST_ENDPOINT=
# RPC pool shaping (defaults: 8 concurrent, 50ms min interval).
RPC_MAX_CONCURRENT_REQUESTS=8
RPC_MIN_INTERVAL_MS=50

# --- Market Data Streams (WebSocket) ---
# Commitment + encoding for account subscriptions.
WS_COMMITMENT=processed
WS_ENCODING=base64
# Solami ingest endpoints (WS market stream + RPC fallback).
SOLAMI_WS_URL=REPLACE_ME_SOLAMI_WS_URL
SOLAMI_RPC_URL=REPLACE_ME_SOLAMI_RPC_URL

# --- Strategy & Risk ---
# Hard minimum net profit in lamports (also settable via config.toml strategy).
# DEFAULT_MIN_PROFIT_LAMPORTS is a compile-time constant; override the floor per
# deployment through config.toml `strategy.min_net_profit_abs`.
MIN_SOL_RESERVE_LAMPORTS=50000000
# Rejects opportunities whose ROI is implausibly high (data-corruption guard).
ARB_MAX_IMPLAUSIBLE_ROI_BPS=100000
# Non-live modes only: skips notional/impact risk checks (diagnostics; ignored in live).
# BYPASS_RISK_GATE=1
# Fixed SOL/USD price for Telegram USD conversions (fallback when no live oracle).
# SOL_USD_PRICE=150.0

# --- Simulation & Dispatch ---
# Mandatory RPC preflight simulation before dispatch (default: enabled).
ENABLE_PREFLIGHT_SIMULATION=true
# Simulation timeout in milliseconds.
ARB_SIM_TIMEOUT_MS=2000
# Bypass the dispatch queue and send immediately after assembly (latency mode).
# FAST_PATH_IMMEDIATE_DISPATCH=1
# Run-loop test exit hatch (CI/shadow diagnostics only).
# ARB_TEST_EXIT=1

# --- Events, Heartbeat & Dashboard ---
ARB_EVENT_LOG=./logs/arb_events.log
HEARTBEAT_PATH=./data/heartbeat.json
DASHBOARD_LISTEN=127.0.0.1:8080
# Canary marker: when set, main.rs runs the canary self-check path.
# ARB_CANARY=1
# Config file path override (default: config.toml).
# ARB_CONFIG=config.toml

# --- Telegram Alerts ---
# Aggregate digest interval; individual alerts can be silenced for noise control.
TELEGRAM_DIGEST_INTERVAL_SECS=300
TELEGRAM_MIN_ALERT_USD=0.10
# TELEGRAM_SILENCE_INDIVIDUAL_ALERTS=1

# --- Test-only (integration tests; never used by the running bot) ---
# ARB_MAINNET_RPC_URL, ARB_MAINNET_ALT_ADDRESS, ARB_TEST_REAL_ALT_ADDRESS,
# ARB_TEST_EXIT — see crates/arb-tx/tests/mainnet_alt_integration_tests.rs.
