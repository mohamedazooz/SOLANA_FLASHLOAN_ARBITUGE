# Sentinel Solana Arbitrage Bot — Environment Variable Template
# Copy this file to .env and fill in actual values. NEVER commit .env to git.
# All values below are placeholders — replace with real credentials before use.

# ── Solana Signing ──
# Private key for the hot wallet that signs transactions.
# Format: base58-encoded private key OR path to a keypair JSON file.
SOLANA_PRIVATE_KEY=your_base58_private_key_here
# SOLANA_KEYPAIR_PATH=secrets/solana_keypair.json  # alternative: keypair file path

# ── Operator Keys ──
OPERATOR_PRIVATE_KEY=your_operator_private_key_here
OPERATOR_PUBLIC_KEY=your_operator_public_key_here

# ── Profit Sweep ──
PROFIT_RECEIVER_ADDRESS=your_profit_receiver_address_here
COLD_WALLET_ADDRESS=your_cold_wallet_address_here

# ── Admin API (Bearer token, constant-time compared) ──
# Must NOT be a placeholder. Empty/missing disables the admin listener (fail closed).
SENTINEL_ADMIN_KEY=your_admin_bearer_token_here

# ── JWT / WebSocket ──
JWT_SECRET=your_jwt_secret_here
SENTINEL_WS_SECRET=your_websocket_secret_here

# ── Data / RPC Providers ──
JUPITER_API_KEY=your_jupiter_api_key_here
HELIUS_API_KEY=your_helius_api_key_here
SHYFT_API_KEY=your_shyft_api_key_here
SOLAMI_API_KEY=your_solami_api_key_here

# ── Alerts ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Webhook Security ──
ALCHEMY_WEBHOOK_SIGNING_KEY=your_alchemy_webhook_signing_key_here

# ── Optional Research ──
HF_TOKEN=your_huggingface_token_here
# S3_ACCESS_KEY_ID=your_s3_access_key_here
# S3_SECRET_ACCESS_KEY=your_s3_secret_key_here

# ── Bot Mode ──
# "shadow" | "simulate" | "live" — live requires ARB_LIVE=1 and all security controls.
ARB_LIVE=0
BOT_MODE=shadow

# ── Jito ──
JITO_TIP_FLOOR_URL=https://bundles.jito.wtf/api/v1/bundles/tip_floor
JITO_TIP_WS_URL=wss://bundles.jito.wtf/api/v1/bundles/tip_stream

# ── Webhook Service ──
WEBHOOK_AUTH_TOKEN=your_webhook_auth_token_here
WEBHOOK_LISTEN=127.0.0.1:8085

# ── Database ──
# DATABASE_URL=sqlite://arb_sentinel.db
