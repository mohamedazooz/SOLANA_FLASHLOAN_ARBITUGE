# ============================================================================
# SOLANA ARBITRAGE BOT — PRODUCTION .env TEMPLATE
# Updated: 2026-11-13
#
# Every key below is consumed by bot/test code as of 2026-11-13. Keys for
# providers that are not part of the actual execution path (1inch, OKX,
# Binance, Arbitrum/EVM, HuggingFace, Beam, webhook domain, ...) were removed
# after a full-repo consumption audit; see docs/quality/PHASE_12_REPOSITORY_AUDIT.md.
#
# تحذير أمني: هذا الملف يحتوي على أماكن شاغرة (REPLACE_ME) فقط.
# لا تضع أي مفتاح حقيقي هنا ثم ترفعه إلى git. هذا الملف مؤشر في .gitignore.
# قبل أي تشغيل مباشر، يجب تدوير كل المفاتيح التي ظهرت بنص عادي في المحادثات السابقة.
# ============================================================================

# NOTE: DRY_RUN is heartbeat-reported only; the real live gates are
# ARB_LIVE / LIVE / EXECUTE_LIVE / ARB_MODE below.
DRY_RUN=true
LIVE=false
EXECUTE_LIVE=false
ARB_LIVE=0
# Bot mode (env-only control, no config.toml / CLI mode):
#   simulate | live | canary  (default: simulate). live additionally requires ARB_LIVE=1.
ARB_MODE=simulate

# --- Additional mode & dispatch controls (read by arb-bot; safe defaults) ---
# Presence-flag: when set (any value), selects canary mode if ARB_MODE is unset
# (arb-bot/src/main.rs mode precedence: ARB_MODE > ARB_CANARY > ARB_LIVE/LIVE/EXECUTE_LIVE > simulate).
#ARB_CANARY=1
# Optional path to the bot config file (default: config.toml).
#ARB_CONFIG=config.toml
# DANGEROUS: when true, bypasses the fire-time dispatch gate
# (supervisor/dispatch.rs). Leave unset in every non-live environment.
#FAST_PATH_IMMEDIATE_DISPATCH=false
# Static SOL/USD override used for USD trade sizing and Telegram alert math
# when no live price source is fresh (positive float; unset = derive/refuse).
#SOL_USD_PRICE=0.0
# Set true to suppress individual Telegram alerts in favor of the consolidated
# minute/five-minute digest (individual alerts are ON by default).
#TELEGRAM_SILENCE_INDIVIDUAL_ALERTS=false

# --- Live Execution Gate ---
MAX_TRADE_SIZE_USD=REPLACE_ME_MAX_TRADE_SIZE_USD

# --- Wallet & Operator Credentials (أضف مفاتيحك الجديدة فقط بعد التدوير) ---
SOLANA_PRIVATE_KEY=REPLACE_ME_SOLANA_PRIVATE_KEY_BASE58

# --- Persistence ---
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=sqlite:///./data/warm/sentinel_state.db
# PostgreSQL alternative (used when DATABASE_URL starts with postgres://):
# DATABASE_URL=postgres://user:pass@host:5432/db
# Note: the PostgreSQL store connects without TLS (trusted-network topology,
# e.g. docker-compose or a private VPC); TLS-requiring hosts fail closed at
# connect time and the bot falls back to SQLite with a warning.

# --- Sentinel Admin & JWT ---
# The admin HTTP API (/pause, /resume) is DISABLED unless SENTINEL_ADMIN_KEY is
# set to a non-placeholder value. Send it as "Authorization: Bearer <key>" or
# "X-Admin-Token: <key>". The API also stays bound to the loopback address.
# (config.toml `token_env` names this variable; it is resolved at runtime.)
SENTINEL_ADMIN_KEY=REPLACE_ME_SENTINEL_ADMIN_KEY
# Durable kill-switch marker. If this file exists at startup the bot starts
# PAUSED (fail safe). /pause creates it, /resume removes it. Default: data/kill_switch
KILL_SWITCH_FILE=./data/kill_switch
# Overrides for the kill-switch marker path / emergency disable (ops only).
# KILL_SWITCH_PATH=./data/kill_switch
# KILL_SWITCH_DISABLED=1

# --- Solana Streaming: Yellowstone gRPC (Helius LaserStream -> solami fallback) + provider-neutral WebSockets ---
# HTTP JSON-RPC endpoints are intentionally not part of the market-data architecture.
#
# OPERATOR PROVIDER MATRIX (2026-11-13): Helius + Alchemy + Solami for both
# WebSocket streaming and JSON-RPC. All three feed the same fail-over pools:
#   RPC pool  (crates/arb-ingest/src/rpc_pool.rs):
#     HELIUS_RPC_URL / HELIUS_API_KEY -> https://mainnet.helius-rpc.com/?api-key=..
#     ALCHEMY_API_KEY (key only)      -> https://solana-mainnet.g.alchemy.com/v2/<key>
#     ALCHEMY_RPC_URL (full URL)      -> used as-is
#     SOLAMI_RPC_URL (key only)       -> https://rpc.solami.dev/sol?api_key=<key>
#   WS pool   (crates/arb-ingest/src/helius_ws.rs):
#     SOLANA_WS_PRIMARY / SOLANA_WS_FALLBACK_1 / SOLANA_WS_FALLBACK_2 (full URLs)
#     ALCHEMY_WS_URL, HELIUS_WS_URL, SOLAMI_WS_URL (full URLs)
#     HELIUS_API_KEY -> wss://mainnet.helius-rpc.com/?api-key=.. (auto-built)
#   Yellowstone gRPC ingest: HELIUS_LASERSTREAM_ENDPOINT + HELIUS_API (x-token).
#   (Reserved future path; not yet consumed by bot code — see
#   docs/quality/Remaining_Risks.md.)
# Verified live 2026-11-13: Solami RPC OK (slot ~21ms RTT); Solami WS and the
# operator Alchemy key were rejected by the providers (see
# docs/quality/Remaining_Risks.md) — configure valid keys before relying on
# those paths.
# Helius endpoints per official docs (https://www.helius.dev/docs/agents/overview):
#   Mainnet RPC : https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   Mainnet WSS : wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   Gatekeeper Beta (lower latency, same key; strips Cloudflare from the path):
#                 https://beta.helius-rpc.com/?api-key=YOUR_KEY
#                 wss://beta.helius-rpc.com/?api-key=YOUR_KEY
#   Sender      : https://sender.helius-rpc.com/fast (low-latency tx submission;
#                 multi-path routing: Helius, Jito, Harmonic, Rakurai, ...)
#   Priority fee: getPriorityFeeEstimate (1 credit) — consumed by rpc_pool.rs.
# Agent-plan rate limits: 10 req/s RPC, 2 req/s DAS/Enhanced — keep
# RPC_MAX_CONCURRENT_REQUESTS/RPC_MIN_INTERVAL_MS within budget.
# NOTE (verified 2026-11-13): HELIUS_LASERSTREAM_ENDPOINT and HELIUS_BETA_URL
# are NOT yet consumed by bot code — actual ingest is the Helius WebSocket
# (helius_ws.rs) + Solami stream; LaserStream gRPC wiring is a future item.
# Helius keys can be IP-allowlisted in the dashboard: add the deploy host's IP
# or every RPC call returns 403 Forbidden.
HELIUS_LASERSTREAM_ENDPOINT=https://laserstream-mainnet-fra.helius-rpc.com
HELIUS_API=REPLACE_ME_HELIUS_API_KEY
# Optional Helius stack overrides (defaults shown):
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_BETA_URL=https://beta.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_SENDER_URL=https://sender.helius-rpc.com
# HELIUS_SENDER_REGIONAL=http://fra-sender.helius-rpc.com
SOLAMI_API_KEY=REPLACE_ME_SOLAMI_YELLOWSTONE_X_TOKEN

# Three interchangeable Solana PubSub WebSocket slots; choose any compatible providers.
# Runtime WebSocket failover adapter is a separate acceptance item; no HTTP fallback exists.
SOLANA_WS_1_URL=REPLACE_ME_SOLANA_WS_1_URL
SOLANA_WS_2_URL=REPLACE_ME_SOLANA_WS_2_URL
SOLANA_WS_3_URL=REPLACE_ME_SOLANA_WS_3_URL

CHRONOS_DECAY_LAMBDA_PER_SEC=REPLACE_ME_CHRONOS_DECAY_LAMBDA_PER_SEC
CHRONOS_MAX_AGE_MS=REPLACE_ME_CHRONOS_MAX_AGE_MS
CHRONOS_MIN_EV_USD=REPLACE_ME_CHRONOS_MIN_EV_USD

# --- Jito Block Engine & MEV Protection ---
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles

# --- Jupiter (diagnostic-only: bin/validate math differential reference) ---
JUPITER_API_KEY=REPLACE_ME_JUPITER_API_KEY
JUP_API_KEY=REPLACE_ME_JUP_API_KEY

# --- Net-profit floor (USD-denominated override; integer lamports downstream) ---
# Raises strategy.min_net_profit_abs / dlmm_three_leg.min_profit_lamports when
# both this and SOL_USD_PRICE are set. Example: 0.05 USD at SOL=200 -> 250,000 lamports.
MIN_NET_PROFIT_USD=0.05

# --- Alerts & Telemetry ---
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_ME_TELEGRAM_CHAT_ID
TELEGRAM_REJECTED_ALERT_MIN_SOL=0.005

# --- Alchemy (RPC + WS + webhooks) ---
# ALCHEMY_API_KEY alone is enough for the RPC pool (URL auto-built above);
# ALCHEMY_RPC_URL / ALCHEMY_WS_URL accept full URLs when role separation is
# needed.
ALCHEMY_API_KEY=REPLACE_ME_ALCHEMY_API_KEY
ALCHEMY_RPC_URL=REPLACE_ME_ALCHEMY_RPC_URL
ALCHEMY_WS_URL=REPLACE_ME_ALCHEMY_WS_URL

# --- Bitquery V2 GraphQL & Streaming Configuration ---
BITQUERY_CLIENT_ID=REPLACE_ME_BITQUERY_CLIENT_ID
BITQUERY_CLIENT_SECRET=REPLACE_ME_BITQUERY_CLIENT_SECRET
BITQUERY_ACCESS_TOKEN=REPLACE_ME_BITQUERY_ACCESS_TOKEN
BITQUERY_OAUTH_URL=REPLACE_ME_BITQUERY_OAUTH_URL
BITQUERY_GRAPHQL_URL=REPLACE_ME_BITQUERY_GRAPHQL_URL

# --- Health Monitor ---
DATA_DIR=/opt/arb-bot/data
# Solana Transaction V1 (4096-byte, SIMD-0385) is mainnet-active, but opt-in per
# transport. Set true ONLY after every configured RPC/sender and its
# validator/leader path is verified V1-capable.
# - SOLANA_TX_V1_DIRECT_ENABLED: direct SWQoS/RPC sendTransaction path.
#   (A Jito-ingress V1 toggle was previously documented here but is NOT
#   consumed by bot code; removed 2026-11-13 — see
#   docs/quality/KNOWN_LIMITATIONS.md.)
# Defaults to false (fail-closed at the legacy 1232-byte MTU).
SOLANA_TX_V1_DIRECT_ENABLED=false

# ============================================================================
# RUNTIME / ENGINE VARIABLES (all read by bot code; defaults shown)
# ============================================================================

# --- RPC Endpoints & Pool ---
# Primary JSON-RPC endpoint(s). The pool rotates/failovers across these.
SOLANA_RPC_URL=REPLACE_ME_SOLANA_RPC_URL
SOLANA_RPC_PRIMARY=REPLACE_ME_SOLANA_RPC_PRIMARY
SOLANA_MAINNET_RPC_FALLBACK=REPLACE_ME_SOLANA_MAINNET_RPC_FALLBACK
# Low-latency endpoint preferred for the dispatch hot path (optional).
# FAST_ENDPOINT=
# RPC pool shaping (defaults: 8 concurrent, 50ms min interval).
RPC_MAX_CONCURRENT_REQUESTS=8
RPC_MIN_INTERVAL_MS=50

# --- Market Data Streams (WebSocket) ---
# Commitment + encoding for account subscriptions.
WS_COMMITMENT=processed
WS_ENCODING=base64
# Hard budget on concurrent WS account subscriptions (default 48, hard cap
# 1024). Coverage math: each registered pool consumes Raydium=2 subs (base +
# quote vaults), Orca Whirlpool=1 (pool account), Meteora DLMM=1 (pool
# account), PumpFun=0 (no account feed yet). With N pools the demand is
# roughly 2*raydium + orca + dlmm subs; anything beyond the budget gets NO
# live updates and stays on paced-HTTP hydration only (fail-closed: those
# pools never enter the arbitrage graph). Set this >= your pool demand or
# expect zero opportunities by construction. Providers that reject large
# batch subscriptions trigger the probe-then-batch fail-safe automatically.
WS_MAX_ACCOUNT_SUBS=512
# Solami ingest endpoints (WS market stream + RPC fallback).
# SOLAMI_RPC_URL holds the api KEY (not a URL): the RPC pool builds
# https://rpc.solami.dev/sol?api_key=<SOLAMI_RPC_URL> from it. SOLAMI_WS_URL
# query params are stripped; the WS key resolves as SOLAMI_WS_API_KEY (explicit
# role-separated stream key) -> api_key embedded in SOLAMI_WS_URL ->
# SOLAMI_API_KEY fallback.
SOLAMI_WS_URL=REPLACE_ME_SOLAMI_WS_URL
SOLAMI_WS_API_KEY=REPLACE_ME_SOLAMI_WS_KEY
SOLAMI_RPC_URL=REPLACE_ME_SOLAMI_RPC_URL
# Operator-supplied keys with no bot-code consumer yet (stored commented until
# an env reader exists; real values live only in the gitignored .env):
# SOLAMI_SWQOS_KEY=REPLACE_ME_SOLAMI_SWQOS_KEY
# SOLAMI_SNAPE_KEY=REPLACE_ME_SOLAMI_SNAPE_KEY

# --- Strategy & Risk ---
# Hard minimum net profit in lamports (also settable via config.toml strategy).
# DEFAULT_MIN_PROFIT_LAMPORTS is a compile-time constant; override the floor per
# deployment through config.toml `strategy.min_net_profit_abs`.
MIN_SOL_RESERVE_LAMPORTS=50000000
# Rejects opportunities whose ROI is implausibly high (data-corruption guard).
ARB_MAX_IMPLAUSIBLE_ROI_BPS=100000
# Non-live modes only: skips notional/impact risk checks (diagnostics; ignored in live).
# BYPASS_RISK_GATE=1
# Fixed SOL/USD price for Telegram USD conversions (fallback when no live oracle).
# SOL_USD_PRICE=150.0

# --- Simulation & Dispatch ---
# Mandatory RPC preflight simulation before dispatch (default: enabled).
ENABLE_PREFLIGHT_SIMULATION=true
# Simulation timeout in milliseconds.
ARB_SIM_TIMEOUT_MS=2000
# Bypass the dispatch queue and send immediately after assembly (latency mode).
# FAST_PATH_IMMEDIATE_DISPATCH=1
# Run-loop test exit hatch (CI/shadow diagnostics only).
# ARB_TEST_EXIT=1

# --- Events, Heartbeat & Dashboard ---
ARB_EVENT_LOG=./logs/arb_events.log
HEARTBEAT_PATH=./data/heartbeat.json
# Canary marker: when set, main.rs runs the canary self-check path.
# ARB_CANARY=1
# Config file path override (default: config.toml).
# ARB_CONFIG=config.toml

# --- Telegram Alerts ---
# Aggregate digest interval; individual alerts can be silenced for noise control.
TELEGRAM_DIGEST_INTERVAL_SECS=300
TELEGRAM_MIN_ALERT_USD=0.10
# TELEGRAM_SILENCE_INDIVIDUAL_ALERTS=1

# --- Test-only (integration tests; never used by the running bot) ---
# ARB_MAINNET_RPC_URL, ARB_MAINNET_ALT_ADDRESS, ARB_TEST_REAL_ALT_ADDRESS,
# ARB_TEST_EXIT — see crates/arb-tx/tests/mainnet_alt_integration_tests.rs.

# --- Web application (React dashboard + authenticated REST/WS API) ---
# Bind address: localhost by default; remote access goes through a TLS reverse
# proxy (Caddy/Nginx). The API refuses to start without a real password.
WEB_BIND=127.0.0.1:8080
WEB_ADMIN_PASSWORD=REPLACE_ME_STRONG_OPERATOR_PASSWORD
WEB_SESSION_TTL_SECS=3600
WEB_AUDIT_LOG=data/web_audit.log

# --- Telegram command listener (same unified control service as the web) ---
# Comma-separated chat IDs allowed to issue control commands. Absent -> alert-only.
TELEGRAM_CONTROL_CHAT_IDS=REPLACE_ME_TELEGRAM_CHAT_IDS

# Optional: extra discovery hub mints (comma-separated pubkeys) merged into the
# default hub set. Use for hot meme tokens without recompiling. Invalid entries
# are skipped with a warning.
# ARB_DISCOVERY_HUBS=<mint_pubkey_1>,<mint_pubkey_2>
