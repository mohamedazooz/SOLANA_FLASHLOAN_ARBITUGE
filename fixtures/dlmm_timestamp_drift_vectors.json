      "package": "@meteora-ag/dlmm",
      "version": "1.9.14",
      "decay_statics_source": "dist/index.mjs DLMM.updateReference / DLMM.updateVolatilityAccumulator statics (transcribed verbatim in the generator; call sites on the SDK swap path: getDynamicFee, swapQuoteExactOut, swapQuoteByInputToken)",
      "fee_helpers_source": "officially exported getBaseFee/getVariableFee/getTotalFee/computeFee/computeFeeFromAmount/computeProtocolFee",
      "spec_cross_check": "https://docs.meteora.ag/core-products/dlmm/formulas (Variable Fee decay table, verified 2026-11-21)"
    },
    "engine_under_test": "arb_math::dlmm::fee::update_references_with_decay + update_volatility_accumulator + compute_base_fee/compute_variable_fee/compute_total_fee_rate/compute_fee_to_add/compute_fee_from_amount/compute_protocol_fee",
    "deterministic_rng": "LCG (Numerical Recipes constants), seed 20261121",
    "parity_policy": "docs/quality/QUOTE_PARITY_REPORT.md §1 — unexplained discrepancies are a hard failure"
  },
