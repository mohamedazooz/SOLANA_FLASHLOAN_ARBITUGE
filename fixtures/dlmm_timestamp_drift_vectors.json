{
  "provenance": {
    "kind": "dlmm_timestamp_drift_vectors",
    "description": "Variable-fee volatility state-machine parity vectors: elapsed-time decay of volatility_reference, volatility_accumulator rebuild, and downstream fee rates/amounts. Expected values computed by official SDK code paths, not the engine under test.",
