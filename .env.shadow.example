# Read-only market-data credentials for the shadow-only build.
# Never place SOLANA_PRIVATE_KEY, OPERATOR_PRIVATE_KEY, JITO auth, or wallet files here.
HELIUS_LASERSTREAM_ENDPOINT=https://laserstream-mainnet-fra.helius-rpc.com
HELIUS_API=REPLACE_WITH_HELIUS_READ_ONLY_API_KEY
SOLAMI_GRPC_ENDPOINT=REPLACE_WITH_SOLAMI_ENDPOINT
SOLAMI_API_KEY=REPLACE_WITH_SOLAMI_READ_ONLY_TOKEN
SOLANA_RPC_URL=REPLACE_WITH_READ_ONLY_RPC_ENDPOINT
RUST_LOG=info
DATABASE_URL=sqlite:///app/data/shadow.db
